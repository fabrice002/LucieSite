# =============================================================================
# Modèle de configuration pour la MISE EN PRODUCTION
# =============================================================================
# Copier ce fichier en .env sur le serveur, puis renseigner chaque valeur vide.
# Ne jamais committer le .env rempli : il est ignoré par .gitignore.
#
# Après copie :
#   php artisan key:generate
#   php artisan config:cache && php artisan route:cache && php artisan view:cache
# =============================================================================

APP_NAME="LN Immigration"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://exemple.cm

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# -----------------------------------------------------------------------------
# Base de données — MySQL 8 ou MariaDB 10.11+
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Sessions, cache et files d'attente — Redis en production
# -----------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=redis

QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

BROADCAST_CONNECTION=log

# -----------------------------------------------------------------------------
# Stockage
# -----------------------------------------------------------------------------
# Les scans de passeports et diplômes restent sur le disque privé local.
# Ne jamais basculer cette valeur sur "public" ni sur un bucket public.
FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
# Envoi d'e-mails (SMTP du cabinet)
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Adresse qui reçoit la notification de chaque nouveau dossier déposé.
MAIL_ADMIN_ADDRESS=

# -----------------------------------------------------------------------------
# Sauvegardes distantes (spatie/laravel-backup) — configuré en Phase 6
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
