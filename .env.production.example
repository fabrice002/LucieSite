# =============================================================================
# Modèle de configuration pour la MISE EN PRODUCTION
# =============================================================================
# Copier ce fichier en .env sur le serveur, puis renseigner chaque valeur vide.
# Ne jamais committer le .env rempli : il est ignoré par .gitignore.
#
# Après copie :
#   php artisan key:generate
#   php artisan config:cache && php artisan route:cache && php artisan view:cache
# =============================================================================

APP_NAME="LN Immigration"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://exemple.cm

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# -----------------------------------------------------------------------------
# Base de données — MySQL 8 ou MariaDB 10.11+
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# À renseigner uniquement si mysqldump n'est pas dans le PATH du serveur.
# Sans lui, les sauvegardes de la base échouent silencieusement.
DB_DUMP_BINARY_PATH=

# -----------------------------------------------------------------------------
# Sessions, cache et files d'attente — Redis en production
# -----------------------------------------------------------------------------
# -----------------------------------------------------------------------------
# Proxies de confiance — à ne pas négliger
# -----------------------------------------------------------------------------
# Derrière un reverse proxy (Nginx en frontal, Cloudflare, load balancer) non
# déclaré ici, Laravel voit l'adresse du proxy et non celle du visiteur :
# TOUTES les requêtes partagent la même IP et les limiteurs de débit bloquent
# tout le monde après quelques consultations.
#
#   '*'                     tous les proxies — à ne poser QUE si le serveur
#                           n'est joignable que par le proxy
#   '10.0.0.1,10.0.0.2'     liste explicite
#   '10.0.0.0/8'            plage
TRUSTED_PROXIES=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=redis

QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

BROADCAST_CONNECTION=log

# -----------------------------------------------------------------------------
# Stockage
# -----------------------------------------------------------------------------
# Les scans de passeports et diplômes restent sur le disque privé local.
# Ne jamais basculer cette valeur sur "public" ni sur un bucket public.
FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
# Envoi d'e-mails (SMTP du cabinet)
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Adresse qui reçoit la notification de chaque nouveau dossier déposé.
MAIL_ADMIN_ADDRESS=

# -----------------------------------------------------------------------------
# Conservation des données et consentement
# -----------------------------------------------------------------------------
# Un dossier sans aucune activité depuis RETENTION_MONTHS est définitivement
# effacé, fichiers compris. Un préavis part vers les comptes « admin »
# RETENTION_NOTICE_DAYS jours avant, pour permettre une exception.
RETENTION_MONTHS=36
RETENTION_NOTICE_DAYS=30

# Version de la politique de confidentialité, enregistrée avec le consentement
# de chaque candidat. Sans elle, un consentement n'est pas opposable : on ne
# saurait pas à quoi le candidat a consenti.
# À incrémenter à chaque modification substantielle du texte.
PRIVACY_VERSION=2026-01

# -----------------------------------------------------------------------------
# Analyse antivirus des pièces déposées (ClamAV)
# -----------------------------------------------------------------------------
# Seconde barrière après la validation « mimes » : celle-ci rejette un
# exécutable renommé, mais pas un PDF légitimement formé porteur de code.
# L'analyse est dégradable : ClamAV absent ou arrêté ne bloque aucun dépôt.
DOCUMENT_SCAN_ENABLED=true
DOCUMENT_SCAN_COMMAND=clamdscan
DOCUMENT_SCAN_TIMEOUT=60

# -----------------------------------------------------------------------------
# Sauvegardes distantes (spatie/laravel-backup)
# -----------------------------------------------------------------------------
# Une sauvegarde stockée sur le même serveur que les données ne protège de rien.
# En production, cette valeur DOIT désigner un stockage distant.
BACKUP_DISKS=s3

# Chiffrement des archives — OBLIGATOIRE ici.
#
# Les sauvegardes contiennent des scans de passeports et de diplômes, et
# partent sur un stockage distant qui n'est pas sous votre contrôle.
#
# ⚠ Ce mot de passe se conserve HORS DU SERVEUR (gestionnaire de mots de passe,
#   coffre-fort). Perdu, les sauvegardes deviennent définitivement illisibles :
#   il n'existe aucun moyen de les récupérer.
BACKUP_ARCHIVE_PASSWORD=

# Seuils du contrôle de santé quotidien (php artisan backup:monitor).
# Ajuster le minimum au volume réel une fois le site en service : une archive
# soudainement plus légère signale un dump de base vide ou tronqué.
BACKUP_MINIMUM_MEGABYTES=5
BACKUP_MAXIMUM_MEGABYTES=20000

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
