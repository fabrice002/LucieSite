APP_NAME="LN Immigration"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Le site est entièrement en français.
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 ou MariaDB 10.11+
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=luciedb
DB_USERNAME=root
DB_PASSWORD=

# Dossier contenant mysqldump, si le binaire n'est pas dans le PATH.
# Sous Laragon, par exemple : "C:/laragon/bin/mysql/mysql-8.0.30-winx64/bin"
DB_DUMP_BINARY_PATH=

# Proxies de confiance. Vide en développement (accès direct).
# Derrière un reverse proxy non déclaré, toutes les requêtes partagent l'IP du
# proxy et les limiteurs de débit bloquent tout le monde.
TRUSTED_PROXIES=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# Les documents des candidats vont sur le disque privé (storage/app/private).
# Ne jamais basculer ce disque sur "public".
FILESYSTEM_DISK=local

# En développement : database. En production : redis.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="contact@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Adresse qui reçoit la notification de chaque nouveau dossier déposé.
MAIL_ADMIN_ADDRESS="contact@example.com"

# Conservation des dossiers.
# Un dossier sans aucune activité depuis ce délai est définitivement effacé,
# fichiers compris. Un préavis part vers les administrateurs avant l'échéance.
RETENTION_MONTHS=36
RETENTION_NOTICE_DAYS=30

# Version de la politique de confidentialité, enregistrée avec le consentement
# de chaque candidat. À incrémenter à chaque modification substantielle du texte.
PRIVACY_VERSION=2026-01

# Analyse antivirus des pièces déposées (ClamAV).
# Désactivée en développement : l'installation ne réclame pas ClamAV.
# À passer à true en production — voir DEPLOIEMENT.md.
DOCUMENT_SCAN_ENABLED=false
DOCUMENT_SCAN_COMMAND=clamdscan
DOCUMENT_SCAN_TIMEOUT=60

# Sauvegardes : "local" en développement, "s3" (ou autre disque distant) en production.
BACKUP_DISKS=local

# Chiffrement des archives. Les sauvegardes contiennent des scans de passeports.
# En production, cette valeur est OBLIGATOIRE et se conserve HORS DU SERVEUR :
# perdue, les sauvegardes deviennent définitivement illisibles.
BACKUP_ARCHIVE_PASSWORD=

# Seuils du contrôle de santé (php artisan backup:monitor).
# Une archive plus légère que le minimum trahit un dump de base vide.
BACKUP_MINIMUM_MEGABYTES=1
BACKUP_MAXIMUM_MEGABYTES=5000

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
